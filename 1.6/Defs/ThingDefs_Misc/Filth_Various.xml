<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseFilth">
    <defName>VWE_Filth_BulletHole</defName>
    <label>bullet hole</label>
    <graphicData>
      <texPath>Things/Filth/CoilgunHole</texPath>
    </graphicData>
    <filth>
      <placementMask>
        <li>Terrain</li>
        <li>Unnatural</li>
      </placementMask>
      <!-- Never disappears on its own -->
      <disappearsInDays>0</disappearsInDays>
      <!-- Not washed by rain -->
      <rainWashes>false</rainWashes>
      <!-- Takes a while to remove a bullet hole -->
      <cleaningWorkToReduceThickness>600</cleaningWorkToReduceThickness>
      <!-- Can't attach to pawns -->
      <canFilthAttach>false</canFilthAttach>
      <cleaningSound>Interact_CleanFilth_Dirt</cleaningSound>
    </filth>
    <statBases>
      <BeautyOutdoors>-1</BeautyOutdoors>
    </statBases>
  </ThingDef>

</Defs>
