<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!--========== Gauss rifle ============-->

	<ThingDef ParentName="BaseHumanMakeableGun" Name="VWE_GaussRifle_Base">
		<defName>VWE_Gun_GaussRifle</defName>
		<label>gauss rifle</label>
		<description>A powerful mass driver rifle utilizing magnetic acceleration to launch ferromagnetic sabots. The incredible velocity and specialized ammunition allow it to completely negate most forms of conventional armor.</description>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>Things/Item/Equipment/WeaponRanged/GaussRifle</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>VWE_Interact_GaussRifle</soundInteract>
		<statBases>
			<WorkToMake>70000</WorkToMake>
			<Mass>4.2</Mass>
			<AccuracyTouch>0.5</AccuracyTouch>
			<AccuracyShort>0.6</AccuracyShort>
			<AccuracyMedium>0.55</AccuracyMedium>
			<AccuracyLong>0.5</AccuracyLong>
			<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
      <VEF_GaussProjectileDamageModifier>-0.2</VEF_GaussProjectileDamageModifier>
		</statBases>
		<recipeMaker>
			<researchPrerequisite>VWE_MassDrivers</researchPrerequisite>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
		</recipeMaker>
		<costList>
			<Plasteel>40</Plasteel>
			<ComponentSpacer>3</ComponentSpacer>
		</costList>
		<thingSetMakerTags>
			<li>RewardStandardLowFreq</li>
			<li>RewardStandardQualitySuper</li>
		</thingSetMakerTags>
		<weaponTags>
			<li>SpacerGun</li>
      <!-- Unused, but available to modders -->
			<li>Coilgun</li>
		</weaponTags>
		<verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <!-- Label required for multi verb comp. Translating it is safe, since the comp uses the untranslated label (which RW keeps around). -->
        <label>low power shot</label>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>VWE_Bullet_GaussRifle_LowPower</defaultProjectile>
        <warmupTime>2</warmupTime>
        <range>27.9</range>
        <ticksBetweenBurstShots>16</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <soundCast>VWE_Shot_GaussRifle</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>5</muzzleFlashScale>
      </li>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <!-- Label required for multi verb comp. Translating it is safe, since the comp uses the untranslated label (which RW keeps around). -->
        <label>high power shot</label>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>VWE_Bullet_GaussRifle</defaultProjectile>
        <warmupTime>4</warmupTime>
        <range>27.9</range>
        <ticksBetweenBurstShots>16</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <warmupEffecter>VWE_Warmup_Effect</warmupEffecter>
        <soundCast>VWE_Shot_GaussRifle</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
          <canTargetPawns>true</canTargetPawns>
          <canTargetBuildings>true</canTargetBuildings>
        </targetParams>
      </li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<comps>
      <li Class="VEF.Weapons.CompProperties_MultiVerbWeapon">
        <!-- Uses the untranslated verb label for matching. -->
        <defaultVerbLabel>low power shot</defaultVerbLabel>
        <!-- Also supports DoubleVerbToggle, SingleToggleGizmo, MultiToggleGizmo or FloatMenuGizmo. -->
        <!-- DoubleVerbToggle and DoubleVerbToggleMirrored specifically requires 2 verbs, requires a default verb -->
        <switchMode>DoubleVerbToggleMirrored</switchMode>

        <!-- Default gizmo data. Each verb can include its own label/description/icon override. -->
        <gizmoLabel>High-power mode</gizmoLabel>
        <gizmoDescription>High-power mode improves penetration capability of the shots, allowing them to penetrate several targets, but increases the warm up time of the weapon. The damage diminishes with each target hit.</gizmoDescription>
        <gizmoIconPath>UI/Gizmos/GaussHighPowerModeToggle</gizmoIconPath>

        <verbs>
          <li>
            <!-- Again, uses the untranslated verb label for matching. -->
            <verbLabel>low power shot</verbLabel>
          </li>
          <li>
            <verbLabel>high power shot</verbLabel>
          </li>
        </verbs>
      </li>
		</comps>
	</ThingDef>

  <ThingDef Name="VWE_Bullet_GaussRifle_LowPower" ParentName="BaseBullet">
    <defName>VWE_Bullet_GaussRifle_LowPower</defName>
    <label>gauss rifle sabot</label>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>14</damageAmountBase>
      <armorPenetrationBase>2</armorPenetrationBase>
      <stoppingPower>0.5</stoppingPower>
      <speed>220</speed>
    </projectile>
    <graphicData>
      <texPath>Projectiles/DirectShots/CoilgunShot_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <comps>
      <li Class="VEF.Weapons.Projectile_VisualEffectCompProperties">
        <gaussDistortion>true</gaussDistortion>
        <lightningGlow>true</lightningGlow>
      </li>
    </comps>
    <modExtensions>
      <li Class="VEF.Weapons.ProjectileExtension">
        <filthOnMiss>VWE_Filth_BulletHole</filthOnMiss>
        <filthOnMissChance>1</filthOnMissChance>
        <filthOnMissCount>1</filthOnMissCount>
      </li>
    </modExtensions>
  </ThingDef>

	<VEF.Weapons.ExpandableProjectileDef Name="VWE_Bullet_GaussRifle" ParentName="VWE_Bullet_GaussRifle_LowPower">
		<defName>VWE_Bullet_GaussRifle</defName>
		<thingClass>VEF.Weapons.GaussProjectile</thingClass>
		<graphicData>
			<texPath>Projectiles/Proj_CoilgunFadeIn</texPath>
			<texPathFadeOut>Projectiles/Proj_CoilgunFadeOut</texPathFadeOut>
		</graphicData>
		<reachMaxRangeAlways>true</reachMaxRangeAlways>
		<minDistanceToAffect>1.9</minDistanceToAffect>
		<drawOffscreen>true</drawOffscreen>
		<lifeTimeDuration>50</lifeTimeDuration>
		<widthScaleFactor>0.10</widthScaleFactor>
		<heightScaleFactor>1</heightScaleFactor>
		<startingPositionOffset>(0,0,-1)</startingPositionOffset>
		<totalSizeScale>0.8</totalSizeScale>
		<tickFrameRate>2</tickFrameRate>
		<finalTickFrameRate>2</finalTickFrameRate>
		<tickDamageRate>5</tickDamageRate>
		<dealsDamageOnce>true</dealsDamageOnce>
		<disableVanillaDamageMethod>true</disableVanillaDamageMethod>
		<stopWhenHit>false</stopWhenHit>
    <stopWhenNaturalRockHit>true</stopWhenNaturalRockHit>
    <stopWhenZeroDamageAfterHit>true</stopWhenZeroDamageAfterHit>
		<stopWhenHitAt>
			<li>CollapsedRocks</li>
			<li>RaisedRocks</li>
		</stopWhenHitAt>
    <stopMotionOnFadeoutStarted>true</stopMotionOnFadeoutStarted>
    <impactFleck>VWE_GaussImpact</impactFleck>
    <impactFleckRotation>0~360</impactFleckRotation>
    <impactFleckRotationRate>-240~240</impactFleckRotationRate>
    <impactFleckAngle>-10~10</impactFleckAngle>
    <impactFleckSpeed>20~25</impactFleckSpeed>
    <impactFleckUsesProjectileAngle>true</impactFleckUsesProjectileAngle>
    <triggerWaterSplashes>true</triggerWaterSplashes>
    <filthOnUninterrupted>VWE_Filth_BulletHole</filthOnUninterrupted>
    <filthOnUninterruptedChance>1</filthOnUninterruptedChance>
    <filthOnUninterruptedCount>1</filthOnUninterruptedCount>
    <gauss>
      <includeInterceptChanceFromDistanceForFriendlyFire>true</includeInterceptChanceFromDistanceForFriendlyFire>
      <damageWorkerClass>VEF.Weapons.GaussProjectileLinearDamageWorker</damageWorkerClass>
      <lightningGlow>true</lightningGlow>
      <gaussDistortion>true</gaussDistortion>
    </gauss>
    <comps Inherit="False" />
    <modExtensions Inherit="False" />
	</VEF.Weapons.ExpandableProjectileDef>

